generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketQueueEntry {
  id                 String  @id @default(uuid())
  fanId              String
  fanName            String
  ticketValue        String?
  joinedQueueAt      String
  eventStartsAt      String
  status             String
  loyaltyPoints      Int?
  upgradesLast30Days Int?
  membership         String?
  phoneNumber        String?
  deviceId           String?
  paymentAccount     String?
}
