generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketQueueEntry {
  id                 String          @id @default(uuid())
  fanId              String
  fanName            String
  ticketValue        String?
  joinedQueueAt      String
  eventStartsAt      String
  status             String
  loyaltyPoints      Int?
  upgradesLast30Days Int?
  membership         String?
  phoneNumber        String?
  deviceId           String?
  paymentAccount     String?
  rankedEntries      RankedEntry[]
  fanGroups          FanGroup[]
  excludedEntries    ExcludedEntry[]
}

model FrontRowUpgradeResult {
  id              String          @id @default(uuid())
  createdAt       DateTime        @default(now())
  winnerId        String?         @unique
  winner          RankedEntry?    @relation(fields: [winnerId], references: [id])
  fanGroups       FanGroup[]
  excludedEntries ExcludedEntry[]
}

model RankedEntry {
  id               String                 @id @default(uuid())
  entryId          String
  entry            TicketQueueEntry       @relation(fields: [entryId], references: [id])
  score            Float
  reasons          String[]
  wonResult        FrontRowUpgradeResult?
  representedGroup FanGroup?
}

model FanGroup {
  id                String                @id @default(uuid())
  resultId          String
  result            FrontRowUpgradeResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  entries           TicketQueueEntry[]
  representativeId  String?               @unique
  representative    RankedEntry?          @relation(fields: [representativeId], references: [id])
  connectionReasons String[]
}

model ExcludedEntry {
  id       String                @id @default(uuid())
  resultId String
  result   FrontRowUpgradeResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  entryId  String
  entry    TicketQueueEntry      @relation(fields: [entryId], references: [id])
  reason   String
}
